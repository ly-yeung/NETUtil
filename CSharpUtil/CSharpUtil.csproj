<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
<TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>CSharpUtil.Extensions</PackageId>
    <Version>0.3.0</Version>
    <Authors>Yeung</Authors>
    <Description>Extension-method helpers for strings, numbers, objects and file names: culture-invariant parsing, RMB and byte-size formatting, safe file name and path checks, file kind and media type lookup. JSON helpers ship separately in CSharpUtil.Extensions.Json.</Description>
    <PackageTags>utils;helper;extensions;parsing;file;path;filename;masking;formatting</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ly-yeung/NETUtil</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ly-yeung/NETUtil</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0 adds 40 helpers. Blank and collection checks that work on null (IsNullOrWhiteSpace, IsNullOrEmpty, EmptyIfNull, OrEmpty), white-space normalization, non-blank joining, delimiter cutting, UTF-8 plus Base64/Base64Url encoding, decimal Clamp/SafeDivide/ToPercent, 22-character GUIDs, Unix timestamp conversion with 10/13-digit text parsing, day boundaries, cached Enum [Description] lookup, and ToVersion/ToVersionStamp for ordering instants. Parsing stays culture-invariant and the allocation-sensitive paths stay at zero bytes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nothing to declare, so drop the empty per-TFM dependency groups from the nuspec. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Lets the symbol package point at the exact commit so debuggers can step into the sources on GitHub. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- No third-party dependencies on purpose: JSON helpers live in CSharpUtil.Extensions.Json. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship the repository README inside the package so nuget.org renders it on the package page. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
